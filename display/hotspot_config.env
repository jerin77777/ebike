# ==============================================================================
# Raspberry Pi Wi-Fi Host (Access Point) Configuration for ESP32 Connection
# ==============================================================================
# You can change the SSID name and password here at any time.
# If HOTSPOT_PASS has fewer than 8 characters, an open network will be created
# because the Wi-Fi WPA2 standard mandates at least 8 characters.
# If you want password protection, use e.g. HOTSPOT_PASS="ebike123" (8 characters).

HOTSPOT_SSID="ebike"
HOTSPOT_PASS="123"
HOTSPOT_IFACE="wlan0"
