# ==============================================================================
# Raspberry Pi Wi-Fi Host (Access Point) Configuration for ESP32 Connection
# ==============================================================================
# You can change the SSID name and password here at any time.
# If HOTSPOT_PASS is left blank or has fewer than 8 characters, an open
# network without password will be used. WPA2-PSK requires at least 8 characters.

HOTSPOT_SSID="EBike-ESP32-AP"
HOTSPOT_PASS="ebike1234"
HOTSPOT_IFACE="wlan0"
